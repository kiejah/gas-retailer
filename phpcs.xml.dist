<?xml version="1.0"?>
<ruleset name="LPG Commerce">
	<description>WordPress Coding Standards for the LPG plugin and theme.</description>

	<file>gas-retailer/wp-content/plugins/lpg-commerce-core</file>
	<file>gas-retailer/wp-content/themes/lpg-storefront</file>
	<file>tests</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lpg-commerce-core"/>
				<element value="lpg-storefront"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lpg_"/>
				<element value="LPG\Commerce"/>
				<element value="lpg_storefront"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 class files in the plugin's src/ use PascalCase file names. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/lpg-commerce-core/src/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<!-- Tests aren't shipped: relax rules that don't apply to them. -->
	<exclude-pattern>tests/wp-tests-config.php</exclude-pattern>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
