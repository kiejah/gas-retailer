{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "LPG Storefront (placeholder tokens, pending Phase 4 design sign-off)",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "name": "Base (white)", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Surface", "color": "#F3F5F7" },
				{ "slug": "border", "name": "Border", "color": "#CBD2D9" },
				{ "slug": "border-strong", "name": "Border strong", "color": "#8A96A3" },
				{ "slug": "muted", "name": "Muted text", "color": "#4A5562" },
				{ "slug": "steel", "name": "Steel", "color": "#2D3741" },
				{ "slug": "contrast", "name": "Contrast (charcoal)", "color": "#1C232B" },
				{ "slug": "accent", "name": "Accent", "color": "#C2410C" },
				{ "slug": "accent-dark", "name": "Accent dark", "color": "#9A3412" },
				{ "slug": "accent-light", "name": "Accent light", "color": "#FDBA74" },
				{ "slug": "success", "name": "Success", "color": "#15803D" },
				{ "slug": "warning", "name": "Warning", "color": "#B45309" },
				{ "slug": "error", "name": "Error", "color": "#B91C1C" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System sans-serif",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif"
				},
				{
					"slug": "system-mono",
					"name": "System monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.875rem", "fluid": { "min": "1.375rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xxx-large", "name": "3X large", "size": "3.25rem", "fluid": { "min": "2.125rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "2X small", "size": "0.5rem" },
				{ "slug": "30", "name": "X small", "size": "0.75rem" },
				{ "slug": "40", "name": "Small", "size": "1rem" },
				{ "slug": "50", "name": "Medium", "size": "clamp(1.25rem, 3vw, 1.75rem)" },
				{ "slug": "60", "name": "Large", "size": "clamp(1.75rem, 5vw, 3rem)" },
				{ "slug": "70", "name": "X large", "size": "clamp(2.5rem, 7vw, 4.5rem)" },
				{ "slug": "80", "name": "2X large", "size": "clamp(3.5rem, 10vw, 6.5rem)" }
			]
		},
		"border": {
			"radiusSizes": [
				{ "slug": "small", "name": "Small", "size": "2px" },
				{ "slug": "medium", "name": "Medium", "size": "4px" },
				{ "slug": "large", "name": "Large", "size": "8px" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "raised", "name": "Raised", "shadow": "0 1px 2px rgba(28, 35, 43, 0.08), 0 1px 3px rgba(28, 35, 43, 0.12)" },
				{ "slug": "overlay", "name": "Overlay", "shadow": "0 8px 24px rgba(28, 35, 43, 0.16)" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"css": ":where(a, button, input, select, textarea, summary, [tabindex]):focus-visible { outline: 2px solid var(--wp--preset--color--accent); outline-offset: 2px; }",
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-dark)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--contrast)" }
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "textTransform": "uppercase", "letterSpacing": "0.04em" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "4px",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--contrast)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"typography": { "textDecoration": "underline" }
						}
					}
				},
				"typography": { "fontWeight": "600" }
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": { "text": "currentColor" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/search": {
				"border": {
					"color": "var(--wp--preset--color--border-strong)",
					"radius": "4px"
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
